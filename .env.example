# web3-sec-workspace — Root Environment Configuration
#
# Copy this file and fill in real values:
#   cp .env.example .env
#   $EDITOR .env
#
# IMPORTANT:
# - .env and .env.* are gitignored (see .gitignore)
# - Never commit real secrets, keys, or tokens
# - This workspace is designed to be fully sovereign/local-first
#
# Sub-tools may have their own .env.example (e.g. tools/honeypotscan/.env.example,
# tools/krait/.env.example). Prefer the root one for shared values where possible.

# =============================================================================
# SOVEREIGN AI STACK (OpenFang + vLLM)
# =============================================================================
# These power the local AI audit agents (bin/audit_fang.py, ai/agents/*).
# Defaults match the common sovereign setup (ports 14720 / 14718).

# OpenFang daemon (your local agent runtime)
OPENFANG_API=http://127.0.0.1:14720
OPENFANG_BIN=~/.local/bin/openfang

# vLLM (OpenAI-compatible local inference server)
# The solidity-security-auditor agent (ai/agents/solidity-security-auditor/agent.toml)
# reads VLLM_API_KEY via the "api_key_env" field.
VLLM_PORT=14718
VLLM_API_KEY=                # often left empty for local unauthenticated vLLM

# Optional explicit base URL override (most people don't need this)
# VLLM_BASE_URL=http://127.0.0.1:14718/v1

# =============================================================================
# BLOCKCHAIN APIs (Etherscan family + others)
# =============================================================================
# Many tools (honeypotscan, ghas integrations, custom scripts) need Etherscan
# (or equivalent) keys for contract source / logs / verification.
#
# Honeypotscan in particular supports up to 6 keys for aggressive rate-limit
# dodging across chains. Fill as many as you have.

ETHERSCAN_API_KEY=your_etherscan_api_key_here
# ETHERSCAN_API_KEY_1=
# ETHERSCAN_API_KEY_2=
# ETHERSCAN_API_KEY_3=
# ETHERSCAN_API_KEY_4=
# ETHERSCAN_API_KEY_5=
# ETHERSCAN_API_KEY_6=

# Future: Add other explorers here (BscScan, PolygonScan, etc.) as tools adopt them.
# BSCSCAN_API_KEY=
# POLYGONSCAN_API_KEY=

# =============================================================================
# GITHUB / GHAS (GitHub Advanced Security)
# =============================================================================
# Used by bin/ghas.sh and any MCP-based GHAS tooling.
# Needs appropriate scopes (repo, security_events, etc.).

GITHUB_TOKEN=                # or GH_TOKEN= (some tools prefer the alias)

# =============================================================================
# OPTIONAL / ADVANCED
# =============================================================================
# Add anything else your local sovereign setup or custom scripts need.
# Examples:
# CUSTOM_RPC_ETHEREUM=https://your-private-rpc.example.com
# FOUNDRY_FUZZ_RUNS=10000
# SLITHER_TIMEOUT=300

# =============================================================================
# NOTES FOR SOVEREIGN OPERATION
# =============================================================================
# - This workspace deliberately avoids third-party cloud AI (Anthropic, OpenAI, etc.)
#   except as explicit fallback. The default path is your local vLLM + OpenFang.
# - All localhost endpoints assume you run the sovereign daemons yourself.
# - See scripts/setup-sovereign-ai.sh and docs/SIGNALS.md for more context.
# - Machine-global secrets (if any) live in a single 0600 store outside the repo.
